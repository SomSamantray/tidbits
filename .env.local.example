# Leave both unset to use a local file DB (file:local.db) for development.
# For production, create a Turso database (https://turso.tech) and set:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin authoring form password (see app/admin).
ADMIN_PASSWORD=
# Random secret used to sign admin session + anonymous-visitor cookies.
COOKIE_SECRET=

# Public HTTPS origin used for canonical URLs, previews, JSON-LD, robots, and sitemap.
# Leave unset for local development. Vercel Production uses:
# NEXT_PUBLIC_SITE_URL=https://teedbits.vercel.app
NEXT_PUBLIC_SITE_URL=

# PostHog browser analytics. Use the host for your PostHog data region.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
